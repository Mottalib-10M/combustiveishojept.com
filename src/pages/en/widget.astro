---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/fuel-prices/" title="Fuel prices today by municipality" width="100%" height="1200" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Portugal fuel price calculator – Combustíveis Hoje" description="Copy the code to show the posted diesel and petrol price in every Portuguese municipality on your page, refreshed daily from DGEG data. Free, with a link back." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the Portugal fuel price calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy the code and paste it into your page. It refreshes itself every day with the prices stations report to the DGEG.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link below the calculator stays visible, the calculator is not altered and it comes with no warranty. Portuguese version: <code>{`${SITE_URL}/embed/precos-combustiveis/`}</code>.</p>
    <p><a href={route('contact', lang)}>Contact</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/fuel-prices/" title="Fuel prices today by municipality" width="100%" height="1200" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
